<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>Admin Dashboard - URBANWOOD</title>
  <!-- plugins:css -->
  <link rel="stylesheet" href="/assets/vendors/mdi/css/materialdesignicons.min.css">
  <link rel="stylesheet" href="/assets/vendors/css/vendor.bundle.base.css">
  <!-- Plugin css for this page -->
  <link rel="stylesheet" href="/assets/vendors/jvectormap/jquery-jvectormap.css">
  <link rel="stylesheet" href="/assets/vendors/flag-icon-css/css/flag-icon.min.css">
  <link rel="stylesheet" href="/assets/vendors/owl-carousel-2/owl.carousel.min.css">
  <link rel="stylesheet" href="/assets/vendors/owl-carousel-2/owl.theme.default.min.css">
  <!-- Layout styles -->
  <link rel="stylesheet" href="/assets/css/style.css">
  <!-- End layout styles -->
  <link rel="shortcut icon" href="/assets/images/favicon.png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: system-ui, -apple-system, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      transition: all 0.3s ease;
      overflow-x: hidden;
    }

    .container-fluid {
      flex: 1;
      padding: 15px;
      width: 100%;
      max-width: 100%;
      margin: 0 auto;
    }

    .dashboard-card {
      border-radius: 10px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      transition: transform 0.3s ease;
      margin-bottom: 15px;
      background-color: #fff;
    }

    .dashboard-card:hover {
      transform: translateY(-3px);
    }

    .chart-container {
      position: relative;
      height: 250px;
      margin-bottom: 20px;
    }

    .filter-btn {
      border-radius: 15px;
      padding: 6px 15px;
      margin: 0 3px;
      font-size: 0.85rem;
      transition: all 0.3s ease;
    }

    .filter-btn.active {
      background-color: #007bff;
      color: white;
    }

    .stat-card {
      background: linear-gradient(45deg, #007bff, #00bcd4);
      color: white;
      border-radius: 10px;
      padding: 15px;
      margin-bottom: 15px;
      text-align: center;
    }

    .stat-card i {
      font-size: 2rem;
      margin-bottom: 8px;
    }

    .stat-card h3 {
      font-size: 1.5rem;
      margin: 8px 0;
    }

    .stat-card p {
      font-size: 0.9rem;
      margin: 0;
    }

    /* Theme Styles */
    .gold-blue {
      background: linear-gradient(135deg, #FFD700, #00008B);
      color: #FFFFFF;
    }

    .black-gold {
      background: linear-gradient(135deg, #000000, #FFD700);
      color: #FFFFFF;
    }

    .purple-silver {
      background: linear-gradient(135deg, #800080, #C0C0C0);
      color: #FFFFFF;
    }

    .blue-green {
      background: linear-gradient(135deg, #00008B, #2E8B57);
      color: #FFFFFF;
    }

    .teal-rose {
      background: linear-gradient(135deg, #008080, #FFD1DC);
      color: #000000;
    }

    .dark-mode {
      background: linear-gradient(135deg, #1A1A1A, #4A4A4A);
      color: #FFFFFF;
    }

    .white-mode {
      background: linear-gradient(135deg, #FFFFFF, #F5F5F5);
      color: #000000;
    }

    /* Table Styles */
    .table-container {
      background: #0D1B2A;
      border-radius: 10px;
      padding: 15px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
    }

    .table {
      width: 100%;
      border-collapse: collapse;
    }

    .table th {
      background-color: #FFD700;
      color: #0D1B2A;
      font-weight: bold;
      padding: 10px;
      border-bottom: 2px solid #FFD700;
      text-align: left;
      font-size: 0.9rem;
    }

    .table td {
      background-color: #112D4E;
      color: #FFFFFF;
      padding: 8px;
      border-bottom: 1px solid #FFD700;
      font-size: 0.85rem;
    }

    .table tr:hover {
      background-color: #1B3A5A;
    }

    .badge {
      padding: 6px 10px;
      border-radius: 15px;
      font-size: 0.8rem;
    }

    /* Theme Dropdown */
    .theme-dropdown {
      display: flex;
      justify-content: flex-end;
      margin-bottom: 15px;
    }

    .theme-select {
      background: linear-gradient(45deg, #333, #444);
      color: #fff;
      border: none;
      border-radius: 15px;
      padding: 8px 25px 8px 12px;
      font-size: 0.85rem;
      cursor: pointer;
      box-shadow: 0 3px 5px rgba(0, 0, 0, 0.2);
      transition: all 0.3s ease;
      width: 180px;
      position: relative;
    }

    .theme-select:focus {
      outline: none;
      box-shadow: 0 3px 5px rgba(0, 123, 255, 0.5);
    }

    .theme-select::after {
      content: '\25BC';
      position: absolute;
      right: 8px;
      top: 50%;
      transform: translateY(-50%);
      color: #fff;
      pointer-events: none;
    }

    .theme-select option {
      background: #333;
      color: #fff;
      padding: 8px;
    }

    .theme-select:hover {
      background: linear-gradient(45deg, #444, #555);
    }

    /* Responsive Styles */
    @media (max-width: 1400px) {
      .container-fluid {
        padding: 10px;
      }

      .stat-card h3 {
        font-size: 1.3rem;
      }

      .stat-card p {
        font-size: 0.85rem;
      }

      .chart-container {
        height: 200px;
      }
    }

    @media (max-width: 991px) {
      .container-fluid {
        padding: 8px;
      }

      .dashboard-card {
        margin-bottom: 10px;
      }

      .stat-card {
        padding: 10px;
      }

      .stat-card i {
        font-size: 1.8rem;
      }

      .stat-card h3 {
        font-size: 1.2rem;
      }

      .stat-card p {
        font-size: 0.8rem;
      }

      .filter-btn {
        padding: 5px 12px;
        font-size: 0.8rem;
      }

      .theme-select {
        width: 150px;
        font-size: 0.8rem;
        padding: 6px 20px 6px 10px;
      }

      .table th, .table td {
        font-size: 0.8rem;
        padding: 6px;
      }

      .chart-container {
        height: 180px;
      }
    }

    @media (max-width: 767px) {
      .row {
        flex-direction: column;
      }

      .col-md-3, .col-md-4, .col-md-6, .col-md-8 {
        width: 100%;
      }

      .stat-card {
        padding: 8px;
      }

      .stat-card i {
        font-size: 1.5rem;
      }

      .stat-card h3 {
        font-size: 1.1rem;
      }

      .stat-card p {
        font-size: 0.75rem;
      }

      .filter-btn {
        padding: 4px 10px;
        font-size: 0.75rem;
        margin: 2px;
      }

      .theme-dropdown {
        justify-content: center;
      }

      .theme-select {
        width: 100%;
        max-width: 140px;
      }

      .table-container {
        padding: 10px;
      }

      .table th, .table td {
        font-size: 0.75rem;
        padding: 5px;
      }

      .chart-container {
        height: 150px;
      }

      .table-responsive {
        overflow-x: auto;
      }
    }

    @media (max-width: 576px) {
      .container-fluid {
        padding: 5px;
      }

      .dashboard-card {
        padding: 8px;
      }

      .stat-card {
        padding: 6px;
      }

      .stat-card i {
        font-size: 1.3rem;
      }

      .stat-card h3 {
        font-size: 1rem;
      }

      .stat-card p {
        font-size: 0.7rem;
      }

      .filter-btn {
        padding: 3px 8px;
        font-size: 0.7rem;
      }

      .theme-select {
        font-size: 0.75rem;
        padding: 5px 18px 5px 8px;
      }

      .table th, .table td {
        font-size: 0.7rem;
        padding: 4px;
      }

      .chart-container {
        height: 120px;
      }
    }
  </style>
</head>

<body class="gold-blue">
  <%-include("../../views/partials/admin/header")%>

  <div class="container-fluid py-4">
    <!-- Theme Dropdown -->
    <div class="theme-dropdown">
      <select class="theme-select" onchange="changeTheme(this.value)">
        <option value="gold-blue" selected>Gold & Blue</option>
        <option value="black-gold">Black & Gold</option>
        <option value="purple-silver">Purple & Silver</option>
        <option value="blue-green">Midnight Blue & Green</option>
        <option value="teal-rose">Dark Teal & Rose Gold</option>
        <option value="dark-mode">Dark Mode</option>
        <option value="white-mode">White Mode</option>
      </select>
    </div>

    <!-- Filter Buttons -->
    <div class="text-center mb-4">
      <button class="btn filter-btn active" data-filter="daily">Daily</button>
      <button class="btn filter-btn" data-filter="weekly">Weekly</button>
      <button class="btn filter-btn" data-filter="monthly">Monthly</button>
      <button class="btn filter-btn" data-filter="yearly">Yearly</button>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
      <div class="col-12 col-md-6 col-lg-3">
        <div class="stat-card">
          <i class="fas fa-shopping-cart"></i>
          <h3><%= totalOrders %></h3>
          <p>Total Orders</p>
        </div>
      </div>
      <div class="col-12 col-md-6 col-lg-3">
        <div class="stat-card" style="background: linear-gradient(45deg, #28a745, #20c997);">
          <i class="fas fa-dollar-sign"></i>
          <h3>₹<%= totalSales.toFixed(2) %></h3>
          <p>Total Sales</p>
        </div>
      </div>
      <div class="col-12 col-md-6 col-lg-3">
        <div class="stat-card" style="background: linear-gradient(45deg, #ffc107, #ff9800);">
          <i class="fas fa-users"></i>
          <h3><%= totalCustomers %></h3>
          <p>Total Customers</p>
        </div>
      </div>
      <div class="col-12 col-md-6 col-lg-3">
        <div class="stat-card" style="background: linear-gradient(45deg, #dc3545, #f44336);">
          <i class="fas fa-box"></i>
          <h3><%= totalProducts %></h3>
          <p>Total Products</p>
        </div>
      </div>
    </div>

    <!-- Charts Row -->
    <div class="row mb-4">
      <div class="col-12 col-md-8">
        <div class="dashboard-card">
          <div class="card-body">
            <h5 class="card-title">Sales Overview</h5>
            <div class="chart-container">
              <canvas id="salesChart"></canvas>
            </div>
          </div>
        </div>
      </div>
      <div class="col-12 col-md-4">
        <div class="dashboard-card">
          <div class="card-body">
            <h5 class="card-title">Sales Distribution</h5>
            <div class="chart-container">
              <canvas id="salesDistributionChart"></canvas>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Top Products and Categories -->
    <div class="row mb-4">
      <div class="col-12 col-md-6">
        <div class="dashboard-card">
          <div class="card-body">
            <h5 class="card-title">Top 10 Products</h5>
            <div class="table-container table-responsive">
              <table class="table">
                <thead>
                  <tr>
                    <th>Product</th>
                    <th>Sales</th>
                    <th>Revenue</th>
                  </tr>
                </thead>
                <tbody>
                  <% topProducts.forEach(product => { %>
                    <tr>
                      <td><%= product.name %></td>
                      <td><%= product.quantity %></td>
                      <td>₹<%= product.revenue.toFixed(2) %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
      <div class="col-12 col-md-6">
        <div class="dashboard-card">
          <div class="card-body">
            <h5 class="card-title">Top 10 Categories</h5>
            <div class="table-container table-responsive">
              <table class="table">
                <thead>
                  <tr>
                    <th>Category</th>
                    <th>Sales</th>
                    <th>Revenue</th>
                  </tr>
                </thead>
                <tbody>
                  <% topCategories.forEach(category => { %>
                    <tr>
                      <td><%= category.name %></td>
                      <td><%= category.quantity %></td>
                      <td>₹<%= category.revenue.toFixed(2) %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Ledger Book -->
    <div class="row mb-4">
      <div class="col-12">
        <div class="dashboard-card">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h5 class="card-title">Ledger Book</h5>
              <div>
                <button class="btn btn-sm btn-outline-primary me-2" id="exportExcel">
                  <i class="fas fa-file-excel me-1"></i> Export Excel
                </button>
                <button class="btn btn-sm btn-outline-danger" id="exportPdf">
                  <i class="fas fa-file-pdf me-1"></i> Export PDF
                </button>
              </div>
            </div>
            <div class="table-container table-responsive">
              <table class="table table-striped" id="ledgerTable">
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Products</th>
                    <th>Amount</th>
                    <th>Payment Method</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% orders.forEach(order => { %>
                    <tr>
                      <td><%= new Date(order.createdAt).toLocaleDateString() %></td>
                      <td><%= order.orderId %></td>
                      <td><%= order.userId ? order.userId.name : 'N/A' %></td>
                      <td>
                        <% order.orderItems.forEach(item => { %>
                          <span class="badge bg-info me-1">
                            <%= item.productId ? item.productId.productName : 'N/A' %> (
                            <%= item.quantity %>)
                          </span>
                        <% }); %>
                      </td>
                      <td>₹<%= order.finalAmount.toFixed(2) %></td>
                      <td><span class="badge bg-secondary"><%= order.paymentMethod %></span></td>
                      <td>
                        <span class="badge <%= order.status === 'Delivered' ? 'bg-success' : order.status === 'Pending' ? 'bg-warning' : 'bg-info' %>">
                          <%= order.status %>
                        </span>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>

  <script>
    function changeTheme(theme) {
      document.body.className = theme;
    }

    const salesCtx = document.getElementById('salesChart').getContext('2d');
    let salesChart = new Chart(salesCtx, {
      type: 'line',
      data: {
        labels: JSON.parse('<%- JSON.stringify(chartData.labels) %>'),
        datasets: [{
          label: 'Sales',
          data: JSON.parse('<%- JSON.stringify(chartData.sales) %>'),
          borderColor: '#007bff',
          tension: 0.4,
          fill: true,
          backgroundColor: 'rgba(0, 123, 255, 0.1)'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            grid: {
              color: 'rgba(0, 0, 0, 0.1)'
            }
          },
          x: {
            grid: {
              display: false
            }
          }
        }
      }
    });

    const distributionCtx = document.getElementById('salesDistributionChart').getContext('2d');
    const distributionChart = new Chart(distributionCtx, {
      type: 'doughnut',
      data: {
        labels: JSON.parse('<%- JSON.stringify(chartData.distributionLabels) %>'),
        datasets: [{
          data: JSON.parse('<%- JSON.stringify(chartData.distributionData) %>'),
          backgroundColor: ['#007bff', '#28a745', '#dc3545', '#17a2b8']
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'bottom'
          }
        }
      }
    });

    document.querySelectorAll('.filter-btn').forEach(button => {
      button.addEventListener('click', async function() {
        document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
        this.classList.add('active');
        const filter = this.dataset.filter;
        try {
          const response = await fetch(`/admin/dashboard/filter?filter=${filter}`);
          const data = await response.json();
          salesChart.data.labels = data.labels;
          salesChart.data.datasets[0].data = data.sales;
          salesChart.update();
        } catch (error) {
          console.error('Error updating chart:', error);
        }
      });
    });

    $(document).ready(function() {
      $('#ledgerTable').DataTable({
        order: [[0, 'desc']],
        pageLength: 10,
        language: {
          search: "Search records:"
        }
      });
      $('#exportExcel').click(function() {
        window.location.href = '/admin/download-report/excel?reportType=ledger';
      });
      $('#exportPdf').click(function() {
        window.location.href = '/admin/download-report/pdf?reportType=ledger';
      });
    });
  </script>
</body>

</html>