<%-include("../../views/partials/admin/header")%>
<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .card-custom {
            margin-bottom: 15px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        .status-badge {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 5px;
            font-weight: bold;
        }
        .status-pending { background-color: #ffc107; color: #000; }
        .status-processing { background-color: #17a2b8; color: #fff; }
        .status-shipped { background-color: #28a745; color: #fff; }
        .status-delivered { background-color: #28a745; color: #fff; }
        .status-return-requested { background-color: #dc3545; color:#0d1f30;}
        .status-returned { background-color: #6c757d; color:#0d1f30; }
        .modal-content {
            border-radius: 10px;
            box-shadow: 0 5px 15px #000000c8;
        }
        .card .card-title {
            color: #1e00ff;
            margin-bottom: 1.125rem;
            text-transform: capitalize;
}
        .modal-header {
            border-top-left-radius: 10px;
            border-top-right-radius: 10px;
        }
        .card {
            border: none;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        .btn-success, .btn-danger {
            transition: all 0.3s ease;
        }
        .btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 2px 5px rgba(0,255,0,0.3);
        }
        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 2px 5px rgba(255,0,0,0.3);
        }
    </style>
</head>

<div class="container-fluid">
    <div class="row">
        <!-- Order Summary Card -->
        <div class="col-md-4" style="margin-top:70px;">
            <div class="card card-custom">
                <div class="card-header">
                    <h5 class="card-title">Order Summary</h5>
                </div>
                <div class="card-body">
                    <p><strong>Order ID:</strong> <%= orders.orderId %></p>
                    <p><strong>Total Price:</strong> ₹<%= orders.totalPrice.toFixed(2) %></p>
                    <p><strong>Discount:</strong> ₹<%= orders.discount.toFixed(2) %></p>
                    <p><strong>Final Amount:</strong> ₹<%= orders.finalAmount.toFixed(2) %></p>
                    <p><strong>Payment Method:</strong> <%= orders.paymentMethod ? orders.paymentMethod.toUpperCase() : "Not Available" %></p>
                </div>
            </div>
        </div>
        <!-- Customer and Shipping Details Card -->
        <div class="col-md-4" style="margin-top:70px;">
            <div class="card card-custom">
                <div class="card-header">
                    <h5 class="card-title">Customer & Shipping Details</h5>
                </div>
                <div class="card-body">
                    <% if (orders.userId) { %>
                        <p><strong>Customer Name:</strong> <%= orders.userId.name %></p>
                        <p><strong>Email:</strong> <%= orders.userId.email %></p>
                        <p><strong>Phone:</strong> <%= orders.userId.phone %></p>
                    <% } %>
                    <% if (orders.address) { %>
                        <h6>Shipping Address:</h6>
                        <p>
                            <%= orders.address.addressType %><br>
                            <%= orders.address.landMark %>, <%= orders.address.city %><br>
                            <%= orders.address.state %> - <%= orders.address.pincode %><br>
                            Phone: <%= orders.address.phone %>
                            <% if (orders.address.altPhone) { %>
                                , Alt: <%= orders.address.altPhone %>
                            <% } %>
                        </p>
                    <% } else { %>
                        <p>No address available.</p>
                    <% } %>
                </div>
            </div>
        </div>
        <!-- Coupon and Invoice Details Card -->
        <div class="col-md-4" style="margin-top:70px;">
            <div class="card card-custom">
                <div class="card-header">
                    <h5 class="card-title">Additional Details</h5>
                </div>
                <div class="card-body">
                    <p><strong>Coupon Applied:</strong> <%= orders.couponApplied ? "Yes" : "No" %></p>
                    <p><strong>Invoice Date:</strong> <%= orders.invoiceDate ? new Date(orders.invoiceDate).toDateString() : "Not available" %></p>
                </div>
            </div>
        </div>

        <!-- Order Details Table -->
        <div class="container my-5">
            <h2 class="mb-4">Order Details</h2>
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Product Name</th>
                        <th>Quantity</th>
                        <th>Price</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (orders.orderItems && orders.orderItems.length > 0) { %>
                        <% orders.orderItems.forEach(item => { %>
                            <tr>
                                <td><%= item.name %></td>
                                <td><%= item.quantity %></td>
                                <td>₹<%= item.price %></td>
                                <td>₹<%= item.price * item.quantity %></td>
                                <td>
                                    <% if (item.status === 'Return_Requested') { %>
                                        <span class="text-danger">Requested Return</span>
                                    <% } else { %>
                                        <%= item.status %>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (item.status === 'Return_Requested') { %>
                                        <button class="btn btn-primary" onclick="returnRequest('<%= item._id %>')">View</button>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="text-center">No products found for this order.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
<!-- Modal -->
<div class="modal fade" id="returnRequestModal" tabindex="-1" aria-labelledby="returnRequestModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="returnRequestModalLabel">Return Request Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card mb-3">
                    <div class="card-header bg-light">
                        <h6 class="mb-0">Order Information</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Product Name:</strong> <span id="modalProductName"></span></p>
                                <p><strong>Quantity:</strong> <span id="modalQuantity"></span></p>
                                <p><strong>Price:</strong> ₹<span id="modalPrice"></span></p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Total:</strong> ₹<span id="modalTotal"></span></p>
                                <p><strong>Order Status:</strong> <span class="badge bg-info" id="modalStatus"></span></p>
                                <p><strong>Order Date:</strong> <span id="modalDate"></span></p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card">
                    <div class="card-header bg-light">
                        <h6 class="mb-0">Return Request</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label for="returnReason" class="form-label">Customer's Return Reason:</label>
                            <textarea class="form-control" id="returnReason" rows="3" disabled></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="adminComment" class="form-label">Admin Comment:</label>
                            <textarea class="form-control" id="adminComment" rows="3" placeholder="Enter your comments here..."></textarea>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-dark text-white">
                <button type="button" class="btn btn-success" onclick="acceptReturn()">Accept Return</button>
                <button type="button" class="btn btn-danger" onclick="rejectReturn()">Reject Return</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
</div>

<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

<script>
function changeOrderStatus(orderId, productId, newStatus) {
console.log("Product ID before sending:", productId); 
if (typeof productId === "object" && productId) {
    productId = productId.toString();  
}
if (typeof productId !== "string") {
    console.error("Invalid Product ID:", productId);
    return;
}

Swal.fire({
    title: `Change Status to "${newStatus.charAt(0).toUpperCase() + newStatus.slice(1)}"?`,
    html: `Are you sure you want to update this order's status?`,
    icon: "question",
    iconHtml: "🔄", 
    showCancelButton: true,
    confirmButtonColor: "#28a745", 
    cancelButtonColor: "#d33", 
    confirmButtonText: "Yes, Update!",
    cancelButtonText: "Cancel",
    background: "#2d2d2d", 
    color: "#ffffff",
    iconColor: "#3fc3ee",
    backdrop: `rgba(0, 0, 0, 0.6)`, 
    showLoaderOnConfirm: true, 
    preConfirm: () => {
        return $.ajax({
            url: `/admin/changeStatus/${orderId}`,
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify({ status: newStatus, productId })
        })
        .then((response) => {
            if (response.status) {
                Swal.fire({
                    title: `✅ Status Updated!`,
                    html: `Order status changed to "${newStatus}".`,
                    icon: "success",
                    confirmButtonColor: "#28a745",
                    background: "#2d2d2d",
                    color: "#ffffff",
                    iconColor: "#a5dc86",
                    timer: 2000, 
                    timerProgressBar: true,
                    willClose: () => {
                        location.reload();
                    }
                });
            } else {
                throw new Error(response.message || "Failed to update order status.");
            }
        })
        .catch((error) => {
            console.log(error);
            Swal.fire({
                title: `❌ Update Failed!`,
                html: `${error.message}`,
                icon: "error",
                confirmButtonColor: "#d33",
                background: "#2d2d2d",
                color: "#ffffff",
                iconColor: "#f27474"
            });
        });
    }
});
}

function returnRequest(itemId) {
const row = event.target.closest('tr');
const productName = row.cells[0].textContent;
const quantity = row.cells[1].textContent;
const price = row.cells[2].textContent.replace('₹', '');
const total = row.cells[3].textContent.replace('₹', '');
const status = row.cells[4].textContent;
const orderId = '<%= orders._id %>'; // Use actual order _id for database queries

// Find the item in the order data to get the return reason
<% if (orders.orderItems && orders.orderItems.length > 0) { %>
  let returnReason = '';
  <% orders.orderItems.forEach((item, index) => { %>
    if (itemId === '<%= item._id %>') {
      returnReason = '<%= item.ReturnReason || "No reason provided" %>';
    }
  <% }); %>
  
  // Populate modal with data
  document.getElementById('modalProductName').textContent = productName;
  document.getElementById('modalQuantity').textContent = quantity;
  document.getElementById('modalPrice').textContent = price;
  document.getElementById('modalTotal').textContent = total;
  document.getElementById('modalStatus').textContent = status;
  document.getElementById('modalDate').textContent = '<%= orders.createdAt ? new Date(orders.createdAt).toDateString() : "Not available" %>';
  document.getElementById('returnReason').value = returnReason;
<% } %>

// Store itemId in a data attribute for later use
$('#returnRequestModal').data('itemId', itemId);

// Apply dark theme to modal
document.querySelector('#returnRequestModal .modal-content').style.backgroundColor = '#2d2d2d';
document.querySelector('#returnRequestModal .modal-content').style.color = '#ffffff';
document.querySelectorAll('#returnRequestModal .card').forEach(card => {
    card.style.backgroundColor = '#3d3d3d';
    card.style.color = '#ffffff';
});
document.querySelectorAll('#returnRequestModal .card-header').forEach(header => {
    header.style.backgroundColor = '#4d4d4d';
    header.style.color = '#ffffff';
});
document.querySelectorAll('#returnRequestModal .form-control').forEach(input => {
    input.style.backgroundColor = '#2d2d2d';
    input.style.color = '#ffffff';
    input.style.borderColor = '#4d4d4d';
});

// Show the modal
const modal = new bootstrap.Modal(document.getElementById('returnRequestModal'));
modal.show();
}

function acceptReturn() {
const adminComment = document.getElementById('adminComment').value;
const orderId = '<%= orders._id %>';
const itemId = $('#returnRequestModal').data('itemId');
const productName = document.getElementById('modalProductName').textContent;

console.log("Accept Return data:", { orderId, itemId, comment: adminComment, productName });

Swal.fire({
    title: 'Accept Return Request?',
    text: 'Are you sure you want to accept this return?',
    icon: 'question',
    showCancelButton: true,
    confirmButtonColor: '#28a745',
    cancelButtonColor: '#d33',
    confirmButtonText: 'Yes, Accept!',
    background: '#2d2d2d',
    color: '#ffffff',
    iconColor: '#3fc3ee'
}).then((result) => {
    if (result.isConfirmed) {
        const postData = {
            orderId: orderId,
            itemId: itemId,
            comment: adminComment,
            productName: productName
        };
        
        console.log("Sending AJAX request to /admin/acceptReturn with data:", postData);
        
        $.ajax({
            url: '/admin/acceptReturn', 
            method: 'POST',
            data: postData,
            success: (response) => {
                console.log("Received response:", response);
                if (response.status) {
                    Swal.fire({
                        title: 'Success',
                        text: 'Return request accepted',
                        icon: 'success',
                        background: '#2d2d2d',
                        color: '#ffffff',
                        iconColor: '#a5dc86'
                    }).then(() => location.reload());
                } else {
                    Swal.fire({
                        title: 'Error',
                        text: response.message || 'Failed to accept return',
                        icon: 'error',
                        background: '#2d2d2d',
                        color: '#ffffff',
                        iconColor: '#f27474'
                    });
                }
            },
            error: (error) => {
                console.error("AJAX error:", error);
                Swal.fire({
                    title: 'Error',
                    text: 'Failed to accept return',
                    icon: 'error',
                    background: '#2d2d2d',
                    color: '#ffffff',
                    iconColor: '#f27474'
                });
            }
        });
    }
});
}

function rejectReturn() {
const adminComment = document.getElementById('adminComment').value;
const orderId = '<%= orders._id %>';
const itemId = $('#returnRequestModal').data('itemId');
const productName = document.getElementById('modalProductName').textContent;

console.log("Reject Return data:", { orderId, itemId, comment: adminComment, productName });

if (!adminComment) {
    Swal.fire({
        title: 'Error',
        text: 'Please provide a reason for rejection',
        icon: 'error',
        background: '#2d2d2d',
        color: '#ffffff',
        iconColor: '#f27474'
    });
    return;
}

Swal.fire({
    title: 'Reject Return Request?',
    text: 'Are you sure you want to reject this return?',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#d33',
    cancelButtonColor: '#3085d6',
    confirmButtonText: 'Yes, Reject!',
    background: '#2d2d2d',
    color: '#ffffff',
    iconColor: '#f8bb86'
}).then((result) => {
    if (result.isConfirmed) {
        const postData = {
            orderId: orderId,
            itemId: itemId,
            comment: adminComment,
            productName: productName
        };
        
        console.log("Sending AJAX request to /admin/rejectReturn with data:", postData);
        
        $.ajax({
            url: '/admin/rejectReturn', 
            method: 'POST',
            data: postData,
            success: (response) => {
                console.log("Received response:", response);
                if (response.status) {
                    Swal.fire({
                        title: 'Success',
                        text: 'Return request rejected',
                        icon: 'success',
                        background: '#2d2d2d',
                        color: '#ffffff',
                        iconColor: '#a5dc86'
                    }).then(() => location.reload());
                } else {
                    Swal.fire({
                        title: 'Error',
                        text: response.message || 'Failed to reject return',
                        icon: 'error',
                        background: '#2d2d2d',
                        color: '#ffffff',
                        iconColor: '#f27474'
                    });
                }
            },
            error: (error) => {
                console.error("AJAX error:", error);
                Swal.fire({
                    title: 'Error',
                    text: 'Failed to reject return',
                    icon: 'error',
                    background: '#2d2d2d',
                    color: '#ffffff',
                    iconColor: '#f27474'
                });
            }
        });
    }
});
}
</script>
