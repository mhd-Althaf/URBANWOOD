					</div>

					<!-- Lightbox Gallery -->
					<div class="lightbox" id="product-lightbox">
						<button class="lightbox-close" id="lightbox-close">&times;</button>
						
						<div class="lightbox-content">
							<% product.productImages.forEach(function(image, index) { %>
								<img class="lightbox-img <%= index === 0 ? 'active' : '' %>" 
									 src="/uploads/re-image/<%= image %>" 
									 alt="<%= product.productName %>" 
									 data-index="<%= index %>">
							<% }); %>
							
							<button class="lightbox-nav lightbox-prev" id="lightbox-prev">
								<i class="fa fa-chevron-left"></i>
							</button>
							<button class="lightbox-nav lightbox-next" id="lightbox-next">
								<i class="fa fa-chevron-right"></i>
							</button>
						</div>
						
						<div class="lightbox-thumbnails">
							<% product.productImages.forEach(function(image, index) { %>
								<img class="lightbox-thumbnail <%= index === 0 ? 'active' : '' %>" 
									 src="/uploads/re-image/<%= image %>" 
									 alt="Thumbnail" 
									 data-index="<%= index %>">
							<% }); %>
						</div>
					</div>

					<%
					const originalPrice = product.regularPrice -totalOffer
					%>
				</div>
				<div class="col-lg-5 offset-lg-1">
					<div class="s_product_text">
						<h3>
							<%= product.productName %>
						</h3>
						<div class="price-section">
							<% if (totalOffer > 0 && totalOffer < product.regularPrice) { %>
								<span class="original-price">$<%= originalPrice %></span>
								<span class="regular-price">$<%= product.regularPrice %></span>
								<span class="discount-badge">Save $<%= totalOffer %></span>
							<% } else { %>
								<span class="original-price">$<%= product.regularPrice %></span>
							<% } %>
						</div>
						<ul class="list">
							<li><span>Category</span> : <%= category.name %></li>
							<li><span>Availability</span> : <%= quantity > 0 ? 'In Stock' : 'Out of Stock' %></li>
							<li><span>Stock</span> : <%= quantity %></li>
						</ul>
						<p>
							<%= product.description %>
						</p>

						<% if (quantity> 0) { %>
							<div class="product_count">
								<label for="qty">Quantity:</label>
								<input type="text" name="qty" id="sst" maxlength="12" value="1"
									title="Quantity:" class="input-text qty">
								<button
									onclick="var result = document.getElementById('sst'); var sst = result.value; if( !isNaN( sst )) result.value++;return false;"
									class="increase items-count" type="button"><i
										class="lnr lnr-chevron-up"></i></button>
								<button
									onclick="var result = document.getElementById('sst'); var sst = result.value; if( !isNaN( sst ) && sst > 0 ) result.value--;return false;"
									class="reduced items-count" type="button"><i
										class="lnr lnr-chevron-down"></i></button>
							</div>
							<div class="card_area d-flex align-items-center">
								<button class="primary-btn" onclick="addToCart('<%= product._id %>')">Add to
									Cart</button>
								<a class="icon_btn" href="#" onclick="addToWishlist('<%= product._id %>', event); return false;">
									<i class="lnr lnr-heart"></i>
								</a>
							</div>
							<% } else { %>
								<div class="alert alert-warning">
									This product is currently out of stock
								</div>
								<% } %>
					</div>
				</div>
