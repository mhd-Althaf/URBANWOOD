			transition: background 0.3s;
			border: none;
		}
		
		.lightbox-nav:hover {
			background: rgba(255, 255, 255, 0.3);
		}
		
		.lightbox-prev {
			left: 20px;
		}
		
		.lightbox-next {
			right: 20px;
		}
		
		.lightbox-thumbnails {
