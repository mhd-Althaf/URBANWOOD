<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Details</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
        }

        .container {
            padding: 40px 20px;
        }

        h2 {
            font-weight: 700;
            color: #2c3e50;
            text-align: center;
            margin-bottom: 30px;
        }

        .order-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            padding: 20px;
            margin-bottom: 25px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .order-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
        }

        .order-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #eee;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }

        .order-header h5 {
            font-weight: 600;
            color: #34495e;
            margin: 0;
        }

        .status-badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
        }

        .status-pending {
            background-color: #fff3cd;
            color: #856404;
        }

        .status-shipped {
            background-color: #cce5ff;
            color: #004085;
        }

        .status-delivered {
            background-color: #d4edda;
            color: #155724;
        }

        .status-cancelled {
            background-color: #f8d7da;
            color: #721c24;
        }

        .product-card {
            display: flex;
            align-items: center;
            background: #f9f9f9;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 15px;
            transition: all 0.3s ease;
        }

        .product-card:hover {
            background: #f1f3f5;
            transform: scale(1.02);
        }

        .product-image {
            width: 80px;
            height: 80px;
            object-fit: cover;
            border-radius: 8px;
            margin-right: 15px;
        }

        .product-details {
            flex-grow: 1;
        }

        .product-details h6 {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 5px;
        }

        .btn-show {
            background-color: #b46e59;
            color: white;
            border-radius: 25px;
            padding: 8px 20px;
            transition: all 0.3s ease;
        }

        .btn-show:hover {
            background-color: #a25c48;
            color: white;
            transform: translateY(-2px);
        }

        .btn-danger {
            border-radius: 25px;
            padding: 6px 15px;
            transition: all 0.3s ease;
        }

        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(231, 76, 60, 0.3);
        }

        .summary-card {
            background: #fff;
            border-radius: 10px;
            padding: 15px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
        }.swal2-textarea {
    pointer-events: auto !important;
    opacity: 1 !important;
    z-index: 10000 !important;
}

    </style>
</head>

<body>
    <div class="container mt-4">
        <h2 class="mb-4">Order History</h2>
        <a href="/"><button class="btn btn-success btn-sm mb-4">Home page</button></a>

        <div class="row">
            <% orders.sort((a, b)=> new Date(b.createdAt) - new Date(a.createdAt)).forEach(order => { %>
                <div class="col-md-6 col-lg-4">
                    <div class="order-card">
                        <div class="order-header">
                            <h5>#<%= order.orderId %>
                            </h5>
                            <button class="btn btn-show btn-sm" data-bs-toggle="modal"
                                data-bs-target="#orderModal<%= order.orderId %>">
                                Show Details
                            </button>
                        </div>
                        <p class="mb-1"><strong>Date:</strong>
                            <%= order.createdAt.toLocaleString() %>
                        </p>
                        <p class="mb-1"><strong>Items:</strong>
                            <%= order.orderItems.length %>
                        </p>
                        <p class="mb-0"><strong>Total:</strong> ₹<%= order.finalAmount.toFixed(2) %>
                        </p>
                    </div>
                </div>
                <% }); %>
        </div>
    </div>

    <!-- Modal for each order -->
    <% orders.forEach(order=> { %>
        <div class="modal fade" id="orderModal<%= order.orderId %>" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Order Details #<%= order.orderId %>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="order-card">
                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <h6 class="mb-3">Order Information</h6>
                                    <p class="mb-1">Date: <%= order.createdAt.toLocaleString() %>
                                    </p>
                                    <p class="mb-2">Order Status: <span
                                            class="status-badge status-<%= order.status.toLowerCase() %>">
                                            <%= order.status %>
                                        </span></p>
                                </div>
                                <div class="col-md-6">
                                    <h6 class="mb-3">Payment Details</h6>
                                    <p class="mb-1">Method: <%= order.paymentMethod %>
                                    </p>
                                    <p class="mb-1">Status: <%= order.paymentStatus %>
                                    </p>
                                </div>
                            </div>

                            <div class="row mb-4">
                                <div class="card-body">
                                    <% if (order.userId) { %>
                                        <p><strong>Customer Name:</strong>
                                            <%= order.address.name %>
                                        </p>
                                        <% } %>
                                            <% if (order.address) { %>
                                                <h6>Shipping Address:</h6>
                                                <p>
                                                    <%= order.address.addressType %><br>
                                                        <%= order.address.landMark ? order.address.landMark : 'N/A' %>,
                                                            <%= order.address.city %><br>
                                                                <%= order.address.state %> - <%= order.address.pincode
                                                                        %><br>
                                                                        <p class="mb-1">📞 <%= order.address.phone %>
                                                                        </p>
                                                                        <% if (order.address.altPhone) { %>
                                                                            Alt: <%= order.address.altPhone %>
                                                                                <% } %>
                                                </p>
                                                <% } else { %>
                                                    <p>No address available.</p>
                                                    <% } %>
                                </div>
                            </div>

                            <div class="mb-4">
                                <h6 class="mb-3">Order Items</h6>
                                <% order.orderItems.forEach(item=> { %>
                                    <div class="product-card">
                                        <!-- <img src="<%= item.image || '/images/default-product.jpg' %>"
                                            alt="<%= item.name %>" class="product-image"> -->
                                        <div class="product-details">
                                            <h6>
                                                <%= item.name %>
                                            </h6>
                                            <p class="mb-1">Qty: <%= item.quantity %> | Price: ₹<%=
                                                        item.price.toFixed(2) %> | Total: ₹<%= (item.price *
                                                            item.quantity).toFixed(2) %>
                                            </p>
                                            <div>
                                                <% if ( item.status==="Pending"||item.status==="Processing") { %>
                                                    <button class="btn btn-danger btn-sm"
                                                        onclick="cancelProduct('<%= order._id %>', '<%= item.productId._id%>')">
                                                        Cancel
                                                    </button>
                                                    <% } else { %>
                                                        <span class="text-muted">Item <%= item.status %></span>
                                                        <% } %>
                                                            <% if (item.status==="Delivered" ) { %>
                                                                <button class="btn btn-danger btn-sm ms-2"
                                                                    onclick="returnProduct('<%= order._id %>', '<%= item.productId._id %>')">
                                                                    Return Order
                                                                </button>
                                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                    <% }); %>
                            </div>

                            <div class="row">
                                <div class="col-md-6 ms-auto">
                                    <div class="summary-card">
                                        <table class="table mb-0">
                                            <tr>
                                                <td>Subtotal:</td>
                                                <td class="text-end">₹<%= (order.totalPrice || 0).toLocaleString() %></td>
                                            </tr>
                                            <% if (order.couponCode) { %>
                                            <tr>
                                                <td>Coupon Applied:</td>
                                                <td class="text-end text-success"><%= order.couponCode %></td>
                                            </tr>
                                            <tr>
                                                <td>Discount:</td>
                                                <td class="text-end text-success">-₹<%= (order.discount || 0).toLocaleString() %></td>
                                            </tr>
                                            <% } %>
                                            <tr>
                                                <td>Shipping:</td>
                                                <td class="text-end">
                                                    <% if (!order.shippingCost || order.shippingCost === 0) { %>
                                                        FREE
                                                    <% } else { %>
                                                        ₹<%= order.shippingCost.toLocaleString() %>
                                                    <% } %>
                                                </td>
                                            </tr>
                                            <tr class="fw-bold">
                                                <td>Total:</td>
                                                <td class="text-end">₹<%= (order.finalAmount || 0).toLocaleString() %></td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <% if (["Pending", "Processing" , "Shipped" ].includes(order.status)) { %>
                                <div class="mt-3 text-end">
                                    <button class="btn btn-danger" onclick="cancelOrder('<%= order._id %>')">
                                        Cancel Order
                                    </button>
                                </div>
                                <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <% }); %>

            <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@10"></script>

            <script>
                // All existing functions (cancelProduct, cancelOrder, returnorder) remain unchanged

                // function cancelProduct(orderId, productId) {
                //     console.log("cancelProduct called:", orderId, productId);
                //     Swal.fire({
                //         title: 'Test Cancel',
                //         text: 'Cancel working?',
                //         icon: 'info'
                //     });
                // }

                function cancelProduct(orderId, productId) {
                    console.log("sfghjkdsfadfasfasd", productId);
                    Swal.fire({
                        title: 'Confirm Cancellation',
    text: 'Are you sure you want to cancel this product?',
    icon: 'warning',
    showCancelButton: true,
    cancelButtonText: 'No, keep it',
    confirmButtonText: 'Yes, cancel it!',
    html: `
        <select id="cancelReason" class="swal2-select">
            <option value="" disabled selected>Select a reason</option>
            <option value="Changed my mind">Changed my mind</option>
            <option value="Found a better price">Found a better price</option>
            <option value="Item no longer needed">Item no longer needed</option>
            <option value="Product issue">Product issue</option>
        </select>
    `,
    preConfirm: () => {
        const select = document.getElementById("cancelReason");
        const reason = select.value;

        if (!reason) {
            Swal.showValidationMessage('Please select a reason');
            return false;
        }

        return fetch('/cancel-product', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ orderId, productId, reason })
        })
                                .then(response => response.json())
                                .then(data => {
                                    if (data.success) {
                                        return data;
                                    } else {
                                        throw new Error(data.message || "Cancellation failed");
                                    }
                                })
                                .catch(error => {
                                    Swal.showValidationMessage(`Request failed: ${error.message}`);
                                });
                        },
                        allowOutsideClick: () => !Swal.isLoading(),
                    }).then((result) => {
                        if (result.isConfirmed) {
                            Swal.fire('Cancelled!', 'The product has been cancelled successfully.', 'success').then(() => {
                                location.reload();
                            });
                        } else if (result.dismiss === Swal.DismissReason.cancel) {
                            Swal.fire('Not Cancelled', 'Your product remains in the order.', 'info');
                        }
                    });
                }

                function cancelOrder(orderId) {
                    Swal.fire({
                        title: 'Confirm Cancel Order',
                        text: 'Are you sure you want to cancel this order?',
                        icon: 'warning',
                        showCancelButton: true,
                        cancelButtonText: 'No, keep it',
                        confirmButtonText: 'Yes, cancel it!',
                        inputAttributes: { 'aria-label': 'Type your reason here' },
                        showLoaderOnConfirm: true,
                        preConfirm: (reason) => {
                            if (!reason) reason = "No reason provided";
                            return $.ajax({
                                url: '/cancelOrder',
                                method: 'POST',
                                contentType: 'application/json',
                                data: JSON.stringify({ orderId, reason })
                            })
                                .then((response) => {
                                    if (response.message && response.message.includes("Order cancelled successfully")) {
                                        return response;
                                    } else {
                                        throw new Error(response.message || "Cancellation failed");
                                    }
                                })
                                .catch((error) => {
                                    Swal.showValidationMessage(`Request failed: ${error.message}`);
                                });
                        },
                        allowOutsideClick: () => !Swal.isLoading(),
                    }).then((result) => {
                        if (result.isConfirmed) {
                            Swal.fire('Cancelled!', 'Your order has been cancelled successfully.', 'success').then(() => {
                                window.location.reload();
                            });
                        } else if (result.dismiss === Swal.DismissReason.cancel) {
                            Swal.fire('Cancelled', 'Your order remains active.', 'info');
                        }
                    });
                }

                function returnProduct(orderId, productId) {
                    console.log("returnProduct called:", orderId, productId); // Debug
                    if (!productId) {
                        Swal.fire({
                            title: 'Error',
                            text: 'Product ID is missing. Please contact support.',
                            icon: 'error'
                        });
                        return;
                    }
                    Swal.fire({
                        title: 'Return Order',
                        text: 'Please provide a reason for returning this product',
                        icon: 'warning',
                        input: 'select',
                        inputOptions: {
                            'Damaged Product': 'Damaged Product',
                            'Wrong Product Delivered': 'Wrong Product Delivered',
                            'Quality Issue': 'Quality Issue',
                            'Size/Fit Issue': 'Size/Fit Issue',
                            'Other': 'Other'
                        },
                        inputPlaceholder: 'Select a reason',
                        showCancelButton: true,
                        confirmButtonText: 'Submit Return Request',
                        cancelButtonText: 'Cancel',
                        showLoaderOnConfirm: true,
                        preConfirm: (reason) => {
                            if (!reason) {
                                Swal.showValidationMessage('Please select a reason');
                                return false;
                            }
                            return fetch('/single-return-product', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ orderId, productId, reason })
                            })
                                .then(response => {
                                    if (!response.ok) {
                                        return response.text().then(text => {
                                            throw new Error(text || `HTTP error! Status: ${response.status}`);
                                        });
                                    }
                                    return response.json();
                                })
                                .then(data => {
                                    if (!data.success) {
                                        throw new Error(data.message || 'Return request failed');
                                    }
                                    return data;
                                })
                                .catch(error => {
                                    Swal.showValidationMessage(`Request failed: ${error.message || "Unexpected error occurred"}`);
                                });
                        },
                        allowOutsideClick: () => !Swal.isLoading()
                    }).then((result) => {
                        if (result.isConfirmed && result.value?.success) {
                            Swal.fire({
                                title: 'Return Request Submitted',
                                text: 'Your return request has been submitted successfully',
                                icon: 'success'
                            }).then(() => {
                                window.location.reload();
                            });
                        }
                    });
                }
            </script>
</body>

</html>