<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Failed - URBANWOOD</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <style>
        .payment-failed-container {
            max-width: 600px;
            margin: 50px auto;
            padding: 30px;
            text-align: center;
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
        }
        .payment-failed-icon {
            font-size: 80px;
            color: #dc3545;
            margin-bottom: 20px;
        }
        .retry-btn {
            background-color: #088178;
            color: white;
            padding: 10px 30px;
            border: none;
            border-radius: 5px;
            margin-top: 20px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .retry-btn:hover {
            background-color: #066661;
            transform: translateY(-2px);
        }
        .order-details {
            margin-top: 30px;
            padding: 20px;
            background: #f8f9fa;
            border-radius: 8px;
            text-align: left;
        }
    </style>
</head>
<body>
    <div class="payment-failed-container">
        <i class="fas fa-times-circle payment-failed-icon"></i>
        <h2>Payment Failed</h2>
        <p class="text-muted">We couldn't process your payment. Please try again or choose a different payment method.</p>
        
        <% if (locals.orderId) { %>
        <div class="order-details">
            <h5>Order Details</h5>
            <p>Order ID: <%= orderId %></p>
            <% if (locals.error) { %>
                <p class="text-danger">Error: <%= error %></p>
            <% } %>
        </div>
        <% } %>

        <div class="mt-4">
            <button class="retry-btn" style="background-color: #6c757d; margin-left: 10px;" onclick="window.location.href='/orders'">
                <i class="fas fa-list"></i> View Orders
            </button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html> 