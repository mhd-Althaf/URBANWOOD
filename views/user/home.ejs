<%-include("../../views/partials/user/header.ejs")%>
<!-- Add SweetAlert2 library -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

	<section class="banner-area organic-breadcrumb">
		<div class="container">
			<div class="breadcrumb-banner d-flex flex-wrap align-items-center justify-content-end">
				<div class="col-first">
					<h1>Shopping Cart</h1>
					<nav class="d-flex align-items-center">
						<a href="/">Home<span class="lnr lnr-arrow-right"></span></a>
					</nav>
				</div>
			</div>
		</div>
	</section>
	<!-- Hero Section -->
	<section class="hero-section bg-light py-5">
		<div class="container">
			<div class="row align-items-center">
				<div class="col-lg-6 order-lg-1 order-2">
					<h1 class="display-4 fw-bold mb-4">Transform Your Space with Premium Furniture</h1>
					<p class="lead mb-4">Discover handcrafted furniture that blends comfort, style, and functionality
					</p>
					<a href="#products" class="btn btn-primary btn-lg px-5">Shop Now</a>
				</div>
				<div class="col-lg-6 order-lg-2 order-1 mb-4 mb-lg-0">
					<img src="/img/Luxury Home Decor Modern Bedroom Idea.jpeg" alt="Modern Furniture"
						class="img-fluid rounded-3 shadow">
				</div>
			</div>
		</div>
	</section>

	<!-- Features Section -->
	<section class="features-section py-5 bg-white">
		<div class="container">
			<div class="row g-4">
				<div class="col-md-3 col-6 text-center">
					<div class="feature-card p-4 rounded-3 shadow-sm">
						<i class="fas fa-truck fa-3x text-primary mb-3"></i>
						<h5 class="fw-bold mb-2">Free Shipping</h5>
						<p class="text-muted mb-0">On orders over ₹5000</p>
					</div>
				</div>
				<div class="col-md-3 col-6 text-center">
					<div class="feature-card p-4 rounded-3 shadow-sm">
						<i class="fas fa-undo fa-3x text-primary mb-3"></i>
						<h5 class="fw-bold mb-2">Easy Returns</h5>
						<p class="text-muted mb-0">30-day return policy</p>
					</div>
				</div>
				<div class="col-md-3 col-6 text-center">
					<div class="feature-card p-4 rounded-3 shadow-sm">
						<i class="fas fa-lock fa-3x text-primary mb-3"></i>
						<h5 class="fw-bold mb-2">Secure Payment</h5>
						<p class="text-muted mb-0">100% secure checkout</p>
					</div>
				</div>
				<div class="col-md-3 col-6 text-center">
					<div class="feature-card p-4 rounded-3 shadow-sm">
						<i class="fas fa-headset fa-3x text-primary mb-3"></i>
						<h5 class="fw-bold mb-2">24/7 Support</h5>
						<p class="text-muted mb-0">Dedicated support team</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Products Section -->
	<section id="products" class="products-section py-5">
		<div class="container">
			<div class="text-center mb-5">
				<h2 class="section-title mb-3">Our Latest Collections</h2>
				<p class="text-muted">Explore our curated selection of premium furniture</p>
			</div>

			<div class="row g-4">
				<% if (products && products.length > 0) { %>
					<% products.forEach(function(product, index) { %>
						<div class="col-lg-3 col-md-4 col-6">
							<div class="product-card h-100 border-0 rounded-3 overflow-hidden shadow-sm">
								<div class="product-image position-relative">
									<a href="/product-details/<%= product._id %>">
										<img src="<%= product.productImages && product.productImages.length > 0 ? 
										'/Uploads/re-image/' + product.productImages[0] : 
										'/Uploads/product-images/default.jpg' %>" class="img-fluid product-img" alt="<%= product.productName %>">
									</a>
									<% 
									// Calculate actual price difference and discount
									const actualPriceDiff = product.price - (product.salePrice || product.price);
									const actualDiscountPercentage = Math.round((actualPriceDiff / product.price) * 100);
									
									// Get other applicable offers
									const productOffer = product.productOffer || 0;
									const categoryOffer = product.category ? product.category.offer || 0 : 0;
									
									// Calculate highest applicable discount
									const totalOffer = Math.max(actualDiscountPercentage, productOffer, categoryOffer);
									
									// Display discount badge if there's a discount
									if(totalOffer > 0) { 
									%>
										<span class="badge badge-danger"><%= totalOffer %>% OFF</span>
									<% } %>
								</div>
								<div class="product-details p-3">
									<h6 class="product-title mb-1">
										<a href="/product-details/<%= product._id %>"
											class="text-dark text-decoration-none">
											<%= product.productName %>
										</a>
									</h6>
									<p class="product-brand small text-muted mb-2">
										<%= product.brand || 'Premium Brand' %>
									</p>
									<div class="d-flex justify-content-between align-items-center">
										<!-- <div class="price">
											<% 
											// Define originalPrice and regularPrice for compatibility
											const originalPrice = product.price;
											const regularPrice = product.salePrice || product.price;
											%>
											<% if (totalOffer > 0 && totalOffer < originalPrice) { %>
												<span class="original-price text-muted small ms-2">$<%= originalPrice %></span>
												<span class="regular-price text-primary fw-bold">$<%= regularPrice %></span>
											<% } else { %>
												<span class="original-price text-primary fw-bold">$<%= regularPrice %></span>
											<% } %>
										</div> -->
									</div>
								</div>
							</div>
						</div>
					<% }); %>
				<% } else { %>
					<div class="col-12 text-center">
						<p class="text-muted">No products available at the moment.</p>
					</div>
				<% } %>
			</div>
		</div>
	</section>

	<style>
		.hero-section {
			background: linear-gradient(45deg, #f8f9fa 50%, #ffffff 50%);
		}

		.product-card {
			transition: transform 0.3s ease, box-shadow 0.3s ease;
			position: relative;
		}

		.product-card:hover {
			transform: translateY(-5px);
			box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
		}

		.product-img {
			height: 250px;
			object-fit: cover;
			transition: transform 0.3s ease;
		}

		.product-img:hover {
			transform: scale(1.05);
		}

		.countdown-timer span {
			padding: 10px 20px;
			background: rgba(255, 255, 255, 0.1);
			border-radius: 5px;
			margin: 0 5px;
		}

		.feature-card {
			transition: transform 0.3s ease;
		}

		.feature-card:hover {
			transform: translateY(-5px);
		}

		.far.fa-heart {
			transition: color 0.3s ease;
		}

		.far.fa-heart:hover {
			color: #dc3545 !important;
			/* Red color on hover */
		}

		.btn-light:hover {
			background-color: rgba(255, 255, 255, 0.9) !important;
		}

		/* Add styles for the wishlist button */
		.wishlist-btn {
			transition: all 0.3s ease;
		}

		.wishlist-btn:hover {
			transform: scale(1.1);
		}

		.wishlist-btn i {
			transition: color 0.3s ease;
		}

		.wishlist-btn:hover i {
			color: #dc3545;
		}

		/* Badge styling */
		.badge-danger {
			background: linear-gradient(45deg, #e74c3c, #c0392b);
			color: white;
			padding: 0.5rem 1rem;
			border-radius: 25px;
			font-weight: 600;
			text-transform: uppercase;
			font-size: 0.75rem;
			letter-spacing: 0.5px;
			position: absolute;
			top: 1rem;
			right: 1rem;
			z-index: 2;
		}
	</style>

	<script>
		// Simple Countdown Timer
		function updateTimer() {
			const countdown = document.getElementById('countdown');
			const days = countdown.querySelector('.days');
			const hours = countdown.querySelector('.hours');
			const minutes = countdown.querySelector('.minutes');
			const seconds = countdown.querySelector('.seconds');

			const targetDate = new Date();
			targetDate.setDate(targetDate.getDate() + 7);

			function update() {
				const now = new Date().getTime();
				const difference = targetDate - now;

				days.textContent = Math.floor(difference / (1000 * 60 * 60 * 24));
				hours.textContent = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
				minutes.textContent = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
				seconds.textContent = Math.floor((difference % (1000 * 60)) / 1000);
			}

			update();
			setInterval(update, 1000);
		}

		document.addEventListener('DOMContentLoaded', updateTimer);

		async function addToWishlist(productId, event) {
			try {
				// Prevent default button behavior
				event.preventDefault();
				
				const response = await fetch('/wishlist/add', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
					},
					body: JSON.stringify({ productId })
				});

				const data = await response.json();

				if (data.success) {
					// Get the button element
					const button = event.currentTarget;
					// Find the heart icon within the button
					const heartIcon = button.querySelector('i');
					
					if (heartIcon) {
						heartIcon.classList.remove('far');
						heartIcon.classList.add('fas');
						heartIcon.style.color = '#dc3545'; // Add red color
					}
					
					Swal.fire({
						icon: 'success',
						title: 'Success!',
						text: 'Product added to wishlist successfully',
						showConfirmButton: false,
						timer: 1500
					});
				} else {
					throw new Error(data.message || 'Failed to add to wishlist');
				}
			} catch (error) {
				Swal.fire({
					icon: 'error',
					title: 'Oops...',
					text: error.message || 'Something went wrong!',
				});
			}
		}
	</script>

	<!-- Footer Section -->
	<%-include("../../views/partials/user/footer.ejs")%>