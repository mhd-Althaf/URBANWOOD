  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css">
  <link rel="stylesheet" type="text상을/javascript" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">

  <style>
    /* Reset default margins and ensure full-width responsiveness */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: system-ui, -apple-system, sans-serif;
      background-color: #f3f4f6;
      overflow-x: hidden;
    }

    .container {
      width: 100%;
      max-width: 100%;
      padding: 0 15px;
      margin: 0 auto;
    }

    .container-centered {
      width: 100%;
      max-width: 1600px;
      margin: 0 auto;
      padding: 0 15px;
    }

    .row {
      margin: 0;
      width: 100%;
    }

    /* Filter Form */
    .premium-filter-form {
      background: #fff;
      padding: 1.5rem;
      border-radius: 15px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
      width: 100%;
    }

    .search-container {
      margin-bottom: 1rem;
    }

    .search-input {
      height: 45px;
      border: 2px solid #eee;
      border-radius: 10px;
      padding-left: 1.5rem;
      font-size: 0.9rem;
      width: 100%;
    }

    .search-input:focus {
      border-color: #6366f1;
      box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
    }

    .search-btn {
      background: #6366f1;
      color: white;
      border: none;
      padding: 0 1.5rem;
      border-radius: 10px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      height: 45px;
    }

    .search-btn:hover {
      background: #4f46e5;
    }

    .filter-controls {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .select-wrapper {
      position: relative;
      flex: 1;
      min-width: 150px;
    }

    .premium-select {
      width: 100%;
      height: 45px;
      padding: 0 1rem;
      border: 2px solid #eee;
      border-radius: 10px;
      background: white;
      font-size: 0.9rem;
    }

    .premium-select:hover {
      border-color: #6366f1;
    }

    .apply-filters-btn {
      background: #6366f1;
      color: white;
      border: none;
      padding: 0 1.5rem;
      height: 45px;
      border-radius: 10px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .apply-filters-btn:hover {
      background: #4f46e5;
    }

    /* Product Grid */
    .product-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.5rem;
      padding: 1.5rem 0;
      width: 100%;
      margin: 0 auto;
    }

    .product-card {
      background: #fff;
      border-radius: 18px;
      overflow: hidden;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 6px 8px rgba(0, 0, 0, 0.05);
      position: relative;
      width: 100%;
    }

    .product-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
    }

    .product-image-wrap {
      position: relative;
      padding-top: 100%;
      background: #f8f9fa;
    }

    .product-image {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .product-badge {
      position: absolute;
      top: 1rem;
      left: 1rem;
      z-index: 2;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .badge {
      padding: 0.5rem 1rem;
      border-radius: 25px;
      font-weight: 600;
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 0.5px;
    }

    .badge-danger {
      background: linear-gradient(45deg, #e74c3c, #c0392b);
      color: white;
      position: absolute;
      top: 1rem;
      right: 1rem;
    }

    .badge-primary {
      background: linear-gradient(45deg, #4d88ff, #1a5cff);
      color: white;
    }

    .badge-success {
      background: linear-gradient(45deg, #4dffb8, #1aff94);
      color: white;
    }

    .product-info {
      padding: 1.5rem;
    }

    .product-title {
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 0.75rem;
      color: #2d3748;
    }

    .product-title a {
      color: inherit;
      text-decoration: none;
    }

    .product-title a:hover {
      color: #FF6F00;
    }

    .product-price {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin: 0.75rem 0;
    }

    .price-original {
      font-size: 0.9rem;
      color: #718096;
      text-decoration: line-through;
    }

    .price-sale {
      font-size: 1.2rem;
      font-weight: 800;
      color: #2ecc71;
    }

    .product-actions {
      position: absolute;
      top: 1rem;
      right: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .product-card:hover .product-actions {
      opacity: 1;
    }

    .action-btn {
      width: 35px;
      height: 35px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.9);
      border: none;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      color: #2d3748;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .action-btn:hover {
      background: #FF6F00;
      color: white;
    }

    .add-to-cart {
      width: 100%;
      padding: 0.75rem;
      background: linear-gradient(45deg, #FF6F00, #FF8F00);
      border: none;
      color: white;
      border-radius: 12px;
      font-weight: 600;
      text-transform: uppercase;
      font-size: 0.85rem;
    }

    .add-to-cart:hover {
      box-shadow: 0 4px 12px rgba(255, 111, 0, 0.3);
    }

    .product-rating {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin: 0.5rem 0;
    }

    .stars {
      color: #FFD700;
      display: flex;
      gap: 0.1rem;
    }

    .rating-count {
      font-size: 0.8rem;
      color: #718096;
    }

    .product-hover-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.4);
      opacity: 0;
      transition: opacity 0.3s ease;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .product-card:hover .product-hover-overlay {
      opacity: 1;
    }

    .quick-view-btn {
      padding: 0.5rem 1.5rem;
      background: white;
      border: none;
      border-radius: 30px;
      font-weight: 600;
      color: #FF6F00;
      font-size: 0.85rem;
    }

    .quick-view-btn:hover {
      background: #FF6F00;
      color: white;
    }

    /* Pagination */
    .pagination {
      display: flex;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 2rem;
      padding: 1rem 0;
    }

    .pagination a {
      text-decoration: none;
      padding: 0.5rem 1rem;
      border: 1px solid #ccc;
      border-radius: 5px;
      font-size: 0.9rem;
      color: #2d3748;
    }

    .pagination a:hover {
      background-color: #f1f1f1;
    }

    /* Responsive Styles */
    @media (max-width: 1400px) {
      .container-centered {
        max-width: 1200px;
      }

      .product-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (max-width: 991px) {
      .container-centered {
        max-width: 960px;
      }

      .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .premium-filter-form {
        padding: 1rem;
      }

      .search-input {
        height: 40px;
        font-size: 0.85rem;
      }

      .search-btn, .apply-filters-btn {
        height: 40px;
        font-size: 0.85rem;
        padding: 0 1rem;
      }

      .premium-select {
        height: 40px;
        font-size: 0.85rem;
      }
    }

    @media (max-width: 767px) {
      .container-centered {
        max-width: 100%;
        padding: 0 10px;
      }

      .product-grid {
        grid-template-columns: 1fr;
      }

      .product-info {
        padding: 1rem;
      }

      .product-title {
        font-size: 1rem;
      }

      .price-sale {
        font-size: 1.1rem;
      }

      .add-to-cart {
        font-size: 0.8rem;
        padding: 0.5rem;
      }

      .filter-controls {
        flex-direction: column;
      }

      .select-wrapper {
        min-width: 100%;
      }

      .pagination a {
        padding: 0.4rem 0.8rem;
        font-size: 0.85rem;
      }
    }

    @media (max-width: 576px) {
      .container {
        padding: 0 5px;
      }

      .premium-filter-form {
        padding: 0.75rem;
      }

      .search-input {
        height: 35px;
        font-size: 0.8rem;
      }

      .search-btn, .apply-filters-btn {
        height: 35px;
        font-size: 0.8rem;
      }

      .premium-select {
        height: 35px;
        font-size: 0.8rem;
      }

      .product-title {
        font-size: 0.9rem;
      }

      .quick-view-btn {
        padding: 0.4rem 1rem;
        font-size: 0.8rem;
      }
    }
  </style>
</head>

<body id="category">
  <!-- Start Header Area -->
  <%-include("../../views/partials/user/header")%>
  <!-- End Header Area -->

  <div style="margin-top: 120px;" class="container-centered">
    <div class="container">
      <div class="row">
        <!-- Main Content -->
        <div class="col-12">
          <div class="premium-filter-form">
            <form id="filterForm" method="GET" action="/shop">
              <div class="search-container">
                <div class="input-group">
                  <input type="text" 
                         name="query" 
                         class="form-control search-input" 
                         placeholder="Search for amazing products..."
                         value="<%= filters?.query || '' %>" 
                         id="searchInput" />
                  <div class="input-group-append">
                    <button type="submit" class="search-btn">
                      <i class="fa fa-search"></i>
                      <span>Search</span>
                    </button>
                  </div>
                </div>
              </div>

              <div class="filter-controls">
                <div class="select-wrapper">
                  <select id="sort" name="sort" class="premium-select" onchange="this.form.submit()">
                    <option value="" <%= !filters?.sort ? 'selected' : '' %>>Sort Products</option>
                    <option value="priceAsc" <%= filters?.sort === 'priceAsc' ? 'selected' : '' %>>Price: Low to High</option>
                    <option value="priceDesc" <%= filters?.sort === 'priceDesc' ? 'selected' : '' %>>Price: High to Low</option>
                    <option value="nameAsc" <%= filters?.sort === 'nameAsc' ? 'selected' : '' %>>Name: A to Z</option>
                    <option value="nameDesc" <%= filters?.sort === 'nameDesc' ? 'selected' : '' %>>Name: Z to A</option>
                  </select>
                </div>

                <div class="select-wrapper">
                  <select class="premium-select" id="categorySelect" name="category">
                    <option value="">All Categories</option>
                    <% categories.forEach(category => { %>
                      <option value="<%= category.name %>" <%= filters?.category===category.name ? 'selected' : '' %>>
                        <%= category.name %>
                      </option>
                    <% }) %>
                  </select>
                </div>

                <input type="hidden" name="page" value="<%= currentPage || 1 %>">

                <button type="submit" class="apply-filters-btn">
                  <i class="fa fa-filter"></i>
                  Apply Filters
                </button>
              </div>
            </form>
          </div>

          <!-- Product Grid -->
          <div class="product-grid">
            <% products.forEach(product => { %>
              <% if(product.regularPrice > product.totalOffer) { %>
                <div class="product-card">
                  <div class="product-badge">
                    <% 
                      const actualPriceDiff = product.regularPrice - product.salePrice;
                      const actualDiscountPercentage = Math.round((actualPriceDiff / product.regularPrice) * 100);
                      const productOffer = product.productOffer || 0;
                      const categoryOffer = product.category ? product.category.offer || 0 : 0;
                      const highestOffer = Math.max(actualDiscountPercentage, productOffer, categoryOffer);
                      const finalPrice = product.regularPrice - product.totalOffer;
                    %>
                    <% if (highestOffer > 0) { %>
                      <span class="badge badge-danger"><%= highestOffer %>% OFF</span>
                    <% } %>
                    <% if (product.isNew) { %>
                      <span class="badge badge-primary">NEW ARRIVAL</span>
                    <% } %>
                    <% if (product.isBestSeller) { %>
                      <span class="badge badge-success">BESTSELLER</span>
                    <% } %>
                  </div>

                  <div class="product-image-wrap">
                    <% if (product.productImages && product.productImages.length > 0) { %>
                      <div class="product-image-slider">
                        <img src="/Uploads/re-image/<%= product.productImages[0] %>" 
                             alt="<%= product.productName %>" 
                             class="product-image">
                      </div>
                    <% } else { %>
                      <img src="/default-product.jpg" 
                           alt="<%= product.productName %>" 
                           class="product-image">
                    <% } %>

                    <div class="product-hover-overlay">
                      <a href="/product-details/<%= product._id %>" 
                         class="quick-view-btn">View Product</a>
                    </div>
                  </div>

                  <div class="product-info">
                    <div class="product-rating">
                      <div class="stars">
                        <% for(let i=1; i <= 5; i++) { %>
                          <i class="fa fa-star<%= i <= product.ratings ? '' : '-o' %>"></i>
                        <% } %>
                      </div>
                      <span class="rating-count">(<%= product.reviewCount || 0 %> reviews)</span>
                    </div>

                    <h3 class="product-title">
                      <a href="/product-details/<%= product._id %>">
                        <%= product.productName %>
                      </a>
                    </h3>

                    <div class="product-price">
                      <% if(product.regularPrice > product.totalOffer) { %>
                        <span class="price-original">₹<%= product.regularPrice.toFixed(2) %></span>
                        <span class="price-sale">₹<%= finalPrice.toFixed(2) %></span>
                      <% } else { %>
                        <span class="price-sale">₹0</span>
                      <% } %>
                    </div>

                    <button class="add-to-cart" onclick="addToCart('<%= product._id %>')">
                      <i class="fa fa-shopping-cart me-2"></i>ADD TO CART
                    </button>
                  </div>

                  <div class="product-actions">
                    <button class="action-btn wishlist" 
                            onclick="addToWishlist('<%= product._id %>', event)" 
                            title="Add to Wishlist">
                      <i class="far fa-heart"></i>
                    </button>
                  </div>
                </div>
              <% } %>
            <% }); %>
          </div>

          <!-- Pagination -->
          <div class="pagination">
            <% if (currentPage > 1) { %>
              <a href="?page=<%= currentPage - 1 %><%= filters?.query ? '&query=' + filters.query : '' %><%= filters?.category ? '&category=' + filters.category : '' %><%= filters?.sort ? '&sort=' + filters.sort : '' %>">Previous</a>
            <% } %>
            <% for (let i=1; i <= totalPages; i++) { %>
              <a href="?page=<%= i %><%= filters?.query ? '&query=' + filters.query : '' %><%= filters?.category ? '&category=' + filters.category : '' %><%= filters?.sort ? '&sort=' + filters.sort : '' %>"
                 style="background-color: <%= currentPage === i ? '#ddd' : '#fff' %>;">
                <%= i %>
              </a>
            <% } %>
            <% if (currentPage < totalPages) { %>
              <a href="?page=<%= currentPage + 1 %><%= filters?.query ? '&query=' + filters.query : '' %><%= filters?.category ? '&category=' + filters.category : '' %><%= filters?.sort ? '&sort=' + filters.sort : '' %>">Next</a>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Start Related Product Area -->
  <section class="related-product-area section_gap">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-6 text-center">
          <div class="section-title">
            <h1>Deals of the Week</h1>
            <p>Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="col-lg-9">
          <div class="row">
            <!-- Add related products here if available -->
          </div>
        </div>
        <div class="col-lg-3">
          <div class="ctg-right">
            <a href="#" target="_blank">
              <img class="img-fluid d-block mx-auto" src="img/category/c5.jpg" alt="">
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- End Related Product Area -->

  <!-- Footer -->
  <%-include("../../views/partials/user/footer")%>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/public/userAssets/js/vendor/jquery-2.2.4.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.11.0/umd/popper.min.js" integrity="sha384-b/U6ypiBEHpOf/4+1nzFpr53nxSS+GLCkfwBdFNTxtclqqenISfwAzpKaMNFNmj4" crossorigin="anonymous"></script>
  <script src="/public/userAssets/js/vendor/bootstrap.min.js"></script>
  <script src="/public/userAssets/js/jquery.ajaxchimp.min.js"></script>
  <script src="/public/userAssets/js/jquery.nice-select.min.js"></script>
  <script src="/public/userAssets/js/jquery.sticky.js"></script>
  <script src="/public/userAssets/js/nouislider.min.js"></script>
  <script src="/public/userAssets/js/countdown.js"></script>
  <script src="/public/userAssets/js/jquery.magnific-popup.min.js"></script>
  <script src="/public/userAssets/js/owl.carousel.min.js"></script>
  <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCjCGmQ0Uq4exrzdcL6rvxywDDOvfAu6eE"></script>
  <script src="/public/userAssets/js/gmaps.min.js"></script>
  <script src="/public/userAssets/js/main.js"></script>
  <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>

  <script>
    async function addToCart(productId) {
      try {
        const response = await fetch('/addToCart', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            productId: productId,
            quantity: 1
          })
        });

        const responseText = await response.text();
        let data;
        try {
          data = JSON.parse(responseText);
        } catch (e) {
          Swal.fire({
            icon: 'warning',
            title: 'Login Required',
            text: 'Please login first to add products to your cart.',
            showCancelButton: true,
            confirmButtonText: 'Login Now',
            cancelButtonText: 'Cancel',
            confirmButtonColor: '#2A9D8F',
            cancelButtonColor: '#d33'
          }).then((result) => {
            if (result.isConfirmed) {
              window.location.href = '/login';
            }
          });
          return;
        }

        if (data.success) {
          Swal.fire({
            icon: 'success',
            title: 'Success!',
            text: 'Product added to cart successfully',
            confirmButtonColor: '#2A9D8F'
          }).then(() => {
            fetch('/getCartCount')
              .then(res => res.json())
              .then(cartData => {
                if (cartData.count) {
                  document.querySelector('.cart-count').textContent = cartData.count;
                }
              })
              .catch(err => console.error('Error fetching cart count:', err));
          });
        } else {
          throw new Error(data.message || 'Failed to add product to cart');
        }
      } catch (error) {
        Swal.fire({
          icon: 'error',
          title: 'Error',
          text: error.message || 'Something went wrong. Please try again.',
          confirmButtonColor: '#2A9D8F'
        });
      }
    }

    async function addToWishlist(productId, event) {
      try {
        const response = await fetch('/wishlist/add', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ productId })
        });

        const responseText = await response.text();
        let data;
        try {
          data = JSON.parse(responseText);
        } catch (e) {
          Swal.fire({
            icon: 'warning',
            title: 'Login Required',
            text: 'Please login first to add products to your wishlist.',
            showCancelButton: true,
            confirmButtonText: 'Login Now',
            cancelButtonText: 'Cancel',
            confirmButtonColor: '#2A9D8F',
            cancelButtonColor: '#d33'
          }).then((result) => {
            if (result.isConfirmed) {
              window.location.href = '/login';
            }
          });
          return;
        }

        if (data.success) {
          event.target.classList.remove('far');
          event.target.classList.add('fas');
          Swal.fire({
            icon: 'success',
            title: 'Success!',
            text: 'Product added to wishlist successfully',
            showConfirmButton: false,
            timer: 1500
          });
        } else {
          throw new Error(data.message || 'Failed to add to wishlist');
        }
      } catch (error) {
        Swal.fire({
          icon: 'error',
          title: 'Oops...',
          text: error.message || 'Something went wrong!',
          confirmButtonColor: '#2A9D8F'
        });
      }
    }

    function updateFilters() {
      const searchValue = document.getElementById('searchInput').value;
      const sortValue = document.getElementById('sort').value;
      const categoryValue = document.getElementById('categorySelect').value;

      const params = new URLSearchParams();
      if (searchValue) params.set('query', searchValue);
      if (sortValue) params.set('sort', sortValue);
      if (categoryValue) params.set('category', categoryValue);
      params.set('page', '1');

      window.location.href = `/shop?${params.toString()}`;
    }

    document.getElementById('searchInput').addEventListener('keyup', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        updateFilters();
      }
    });

    document.getElementById('sort').addEventListener('change', updateFilters);
    document.getElementById('categorySelect').addEventListener('change', updateFilters);

    document.getElementById('filterForm').addEventListener('submit', function(e) {
      e.preventDefault();
      updateFilters();
    });
  </script>
</body>
</html>